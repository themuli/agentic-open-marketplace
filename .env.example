# Never use real cards or live Stripe keys in this prototype.
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
INKBOX_API_KEY=
INKBOX_IDENTITY=
COMPANY_IMESSAGE_TO=

# Explicit rehearsal only. Production demo should use Stripe test payments.
ALLOW_MOCK_PAYMENTS=false
AOM_ROLE=market
MARKET_MCP_URL=http://127.0.0.1:3000/mcp
FACILITATOR_URL=http://127.0.0.1:3001
# Generate with npm run setup. Same agent secret on both services.
AOM_AGENT_SECRET=
AOM_ADMIN_SECRET=
AOM_DB_PATH=./data/aom.sqlite
