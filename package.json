{
  "name": "aom-market",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "description": "Agentic Open Marketplace: independent buyer agents compose a 98+1+1 purchase through MCP",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "dev:market": "AOM_ROLE=market mcp-use dev --port 3000",
    "dev:facilitator": "AOM_ROLE=facilitator mcp-use dev --port 3001",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck",
    "setup": "node --import tsx scripts/setup.ts",
    "test": "node --import tsx --test tests/market.test.ts",
    "test:smoke": "node --import tsx scripts/smoke.ts",
    "demo:reset": "node --import tsx scripts/reset.ts",
    "deploy:prepare": "node --import tsx scripts/prepare-deploy.ts",
    "cloud:deploy": "node --import tsx scripts/cloud.ts",
    "cloud:verify": "node --import tsx scripts/verify-cloud.ts",
    "check:secrets": "node --import tsx scripts/check-secrets.ts",
    "precloud:deploy": "npm run check:secrets",
    "demo:integration": "node --import tsx scripts/integration-demo.ts"
  },
  "dependencies": {
    "@inkbox/sdk": "^0.7.19",
    "@modelcontextprotocol/client": "^2.3.1",
    "dotenv": "^18.0.8",
    "mcp-use": "2.10.1",
    "openai": "^7.38.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mcp-use/client": "^2.4.4",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
